# Copy this file to .env.local and fill it in. Only the first block is required to start.

# ── Required ────────────────────────────────────────────────────────────────
# Public address of the app. Platforms send logins back here and download your media from it,
# so for real posting it must be a public HTTPS URL (your domain, or an ngrok/Cloudflare tunnel).
APP_URL=http://localhost:3000
# The password you use to log in.
APP_PASSWORD=
# Random string, 32+ characters. Encrypts saved platform tokens and signs your login.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# ── AI generator (hashtags, keywords, captions) — all options below are free ──
# With nothing set, the generator runs in Basic mode (templates, no AI, no key needed).
#
# Recommended: Google Gemini free tier. Get a key at https://aistudio.google.com/apikey (no card).
# Also checks live trends with Google Search (free daily allowance on gemini-2.5-flash).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
#
# Or Groq free tier: key from https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
#
# Or Ollama, free and fully on your computer (https://ollama.com): run `ollama pull llama3.1`
# OLLAMA_MODEL=llama3.1
# OLLAMA_URL=http://localhost:11434
#
# Or any OpenAI-compatible API (OpenRouter free models, LM Studio, ...)
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=
# AI_MODEL=
#
# Or Anthropic Claude (paid per use, best quality, also checks live trends): https://console.anthropic.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
#
# If several are set, the app tries them in this order and moves to the next if one fails:
# Gemini, Groq, custom, Ollama, Claude, then Basic mode.
# To try one first, set: gemini | groq | ollama | custom | claude | basic
# AI_PROVIDER=

# ── Instagram (Instagram API with Instagram Login) ──────────────────────────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ── Facebook Pages (Facebook Login for Business) ────────────────────────────
META_APP_ID=
META_APP_SECRET=
# If your Meta app uses "Facebook Login for Business", paste its configuration ID here.
# META_LOGIN_CONFIG_ID=

# Shared by Instagram and Facebook comment webhooks. Any string you choose;
# paste the same value into the Meta dashboard when you add the webhook.
META_WEBHOOK_VERIFY_TOKEN=
# META_GRAPH_VERSION=v25.0

# ── TikTok (Login Kit + Content Posting API) ────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Unaudited apps can only post privately. After TikTok approves your audit, set PUBLIC_TO_EVERYONE.
# TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# ── YouTube (Google Cloud OAuth client, YouTube Data API v3 enabled) ───────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# YOUTUBE_PRIVACY_STATUS=public

# ── X (OAuth 2.0, type "Web App") ───────────────────────────────────────────
X_CLIENT_ID=
X_CLIENT_SECRET=
# Reading replies is billed per call on X, so reply automation is off unless you set this to 1.
# X_POLL_REPLIES=1

# ── Optional ────────────────────────────────────────────────────────────────
# Where the database and uploads are stored.
# DATA_DIR=./data
# MAX_UPLOAD_MB=300
# How often (minutes) to check YouTube and X for new comments.
# POLL_INTERVAL_MINUTES=5
# Set this to call /api/cron from an external scheduler (needed on serverless hosts).
# CRON_SECRET=
# DISABLE_INTERNAL_SCHEDULER=1
